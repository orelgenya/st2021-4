{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smpte-ra.org/schemas/2021/2023/BXF/configuration.schema.json",
  "title": "configuration",
  "type": "object",
  "properties": {},
  "$defs": {
    "Configuration": {
      "type": "object",
      "properties": {
        "Name": {
          "title": "Name",
          "$ref": "./bxftypes.schema.json#/$defs/BxfText"
        },
        "ConfigurationData": {
          "type": "array",
          "items": {
