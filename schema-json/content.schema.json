{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smpte-ra.org/schemas/2021/2023/BXF/content.schema.json",
  "title": "content",
  "type": "object",
  "properties": {},
  "$defs": {
    "Content": {
      "type": "object",
      "properties": {
        "@timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "@user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "@sourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "@contentExists": {
          "type": "boolean"
        },
        "@version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "@revisionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ProgramContent": {
              "title": "ProgramContent",
              "$ref": "./programcontent.schema.json#/$defs/ProgramContent",
              "description": "Content that is in the form of full length titles, epsiodes, movies, sports, newscasts, etc."
            }
          },
          "additionalProperties": false,
          "required": [
            "ProgramContent"
          ]
        },
        {
          "type": "object",
          "properties": {
            "NonProgramContent": {
              "title": "NonProgramContent",
              "$ref": "./nonprogramcontent.schema.json#/$defs/NonProgramContent",
              "description": "Content that is typically short in nature and is scheduled in breaks between the segments of a program such as commercials, promos, ids, etc."
            }
          },
          "additionalProperties": false,
          "required": [
            "NonProgramContent"
          ]
        }
      ]
    }
  },
  "additionalProperties": false
}
