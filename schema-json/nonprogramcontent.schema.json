{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smpte-ra.org/schemas/2021/2023/BXF/nonprogramcontent.schema.json",
  "title": "nonprogramcontent",
  "type": "object",
  "properties": {},
  "$defs": {
    "NonProgramContent": {
      "type": "object",
      "properties": {
        "Details": {
          "title": "Details",
          "$ref": "./nonprogramdetail.schema.json#/$defs/NonProgramDetail",
          "description": "Details of the non-program content"
        },
        "ContentMetaData": {
          "title": "ContentMetaData",
          "$ref": "./contentmetadata.schema.json#/$defs/ContentMetaData",
          "description": "Content identifier and other information"
        },
        "SalesContract": {
          "title": "SalesContract",
          "$ref": "./contract.schema.json#/$defs/SalesContract",
          "description": "Contract information for the interstitial content (commercials)"
        },
        "ParentalRating": {
          "type": "array",
          "items": {
            "$ref": "./bxfparentalrating.schema.json#/$defs/BxfParentalRating"
          },
          "description": "Parental rating for the show for one region (PMCP)"
        },
        "PrivateInformation": {
          "title": "PrivateInformation",
          "$ref": "./bxftypes.schema.json#/$defs/BxfPrivateInformation"
        }
      },
      "additionalProperties": false,
      "required": [
        "Details",
        "ContentMetaData"
      ]
    }
  },
  "additionalProperties": false
}
